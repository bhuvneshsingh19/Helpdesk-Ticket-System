            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@helpdesk.dev\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
