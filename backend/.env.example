NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/helpdesk

# REQUIRED in production - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API (CORS)
CLIENT_URL=http://localhost:5173

# Optional: registering with this code creates an admin account (useful for demos / reviewers)
ADMIN_SIGNUP_CODE=
